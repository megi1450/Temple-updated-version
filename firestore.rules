rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function residentOf(flat) { return signedIn() && request.auth.token.role == 'resident' && request.auth.token.flatNumber == flat && request.auth.token.email_verified == true; }
    function admin() { return signedIn() && request.auth.token.role == 'admin' && request.auth.token.email_verified == true; }
    match /users/{flat} {
      allow read: if residentOf(flat) || admin();
      allow write: if false;
      match /residents/{uid} { allow read: if (signedIn() && request.auth.uid == uid && residentOf(flat)) || admin(); allow write: if false; }
      match /registrations/{id} { allow read: if residentOf(flat) || admin(); allow write: if false; }
      match /Donations/{id} { allow read: if residentOf(flat) || admin(); allow write: if false; }
    }
    match /submissions/{id} { allow read: if admin(); allow write: if false; }
    match /Donations/{id} { allow read: if admin(); allow write: if false; }
    match /receiptNumbers/{id} { allow read: if admin(); allow write: if false; }
    match /residentInvites/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
